<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {% set pageTitle = title or site.title %}
    {% set pageDescription = description or site.description %}
    {% set pageUrl = page.url | absoluteUrl %}
    {% set pageImage = (image or site.image) | absoluteUrl %}

    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ pageDescription }}" />
    <meta name="author" content="{{ site.name }}" />
    <meta name="robots" content="{{ robots or 'index, follow' }}" />
    <link rel="canonical" href="{{ pageUrl }}" />

    <meta property="og:type" content="{{ ogType or 'website' }}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="{{ site.locale }}" />
    <meta property="og:title" content="{{ pageTitle }}" />
    <meta property="og:description" content="{{ pageDescription }}" />
    <meta property="og:url" content="{{ pageUrl }}" />
    <meta property="og:image" content="{{ pageImage }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ site.imageAlt }}" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDescription }}" />
    <meta name="twitter:image" content="{{ pageImage }}" />
    <meta name="twitter:image:alt" content="{{ site.imageAlt }}" />

    <meta name="theme-color" content="#0d0d0d" />
    <script>
      // Apply the saved theme before first paint so there's no flash.
      (function () {
        var theme;
        try { theme = localStorage.getItem("theme"); } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        } else {
          document.documentElement.dataset.theme = theme;
        }
        document.querySelector('meta[name="theme-color"]').content = theme === "light" ? "#f5f3ef" : "#0d0d0d";
      })();
    </script>
    <link rel="icon" href="/assets/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href="/assets/manifest.json" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="/assets/css/styles.css" />
  </head>

  <body>
    <a class="skip" href="#content">Skip to content</a>

    {% set navItems = [
      { href: "/about/", text: "About" },
      { href: "/contact/", text: "Contact" }
    ] %}

    <header class="site-header{% if page.url != '/' %} show-avatar{% endif %}" id="site-header">
      <div class="container">
        <a href="/" class="brand" aria-label="{{ cv.name }}, home">
          <img src="/assets/images/maro-192.jpg" alt="" class="brand-avatar" width="24" height="24" />
          <span class="brand-full">{{ cv.name }}</span>
          <span class="brand-short">Maro</span>
        </a>
        <nav class="nav" aria-label="Main">
          {% for item in navItems %}
            <a href="{{ item.href }}"{% if page.url.startsWith(item.href) %} aria-current="page"{% endif %}>{{ item.text }}</a>
          {% endfor %}
          <a href="{{ cv.resume }}" target="_blank" rel="noopener noreferrer" class="ext">Résumé</a>
          <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle colour theme">
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1" />
              <path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="content">
      <div class="container">{{ content | safe }}</div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-inner">
          <p>© {% year %} {{ cv.name }}</p>
          <nav aria-label="Elsewhere">
            <a href="https://www.linkedin.com/in/oghenemaro-okolosio/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="https://github.com/Omarookolosio94" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="mailto:omarookolosio94@gmail.com">Email</a>
          </nav>
        </div>
      </div>
    </footer>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "@id": "{{ site.url }}/#website",
            "url": "{{ site.url }}/",
            "name": "{{ site.name }}",
            "inLanguage": "en"
          },
          {
            "@type": "Person",
            "@id": "{{ site.url }}/#person",
            "name": "{{ cv.name }}",
            "url": "{{ site.url }}/",
            "image": "{{ '/assets/images/maro.jpg' | absoluteUrl }}",
            "jobTitle": "{{ cv.role }}",
            "worksFor": { "@type": "Organization", "name": "Union Bank of Nigeria" },
            "alumniOf": { "@type": "CollegeOrUniversity", "name": "{{ cv.education.school }}" },
            "address": { "@type": "PostalAddress", "addressLocality": "Lagos", "addressCountry": "NG" },
            "email": "mailto:omarookolosio94@gmail.com",
            "knowsAbout": ["Software Engineering", "TypeScript", "React", "Next.js", "Node.js", ".NET", "REST API design", "Fintech"],
            "sameAs": [
              "https://www.linkedin.com/in/oghenemaro-okolosio/",
              "https://github.com/Omarookolosio94"
            ]
          }
        ]
      }
    </script>
    <script>
      (function () {
        var root = document.documentElement;
        var button = document.getElementById("theme-toggle");
        var meta = document.querySelector('meta[name="theme-color"]');
        var system = window.matchMedia("(prefers-color-scheme: light)");

        function current() {
          return root.dataset.theme || (system.matches ? "light" : "dark");
        }

        function label() {
          var next = current() === "dark" ? "light" : "dark";
          button.setAttribute("aria-label", "Switch to " + next + " theme");
          button.title = "Switch to " + next + " theme";
        }

        button.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          meta.content = next === "light" ? "#f5f3ef" : "#0d0d0d";
          try { localStorage.setItem("theme", next); } catch (e) {}
          label();
        });

        label();
      })();

      (function () {
        var header = document.getElementById("site-header");

        // Hairline under the header once the page has moved.
        function onScroll() {
          header.classList.toggle("is-scrolled", window.scrollY > 0);
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();

        // On the home page, the header photo takes over once the portrait passes under the header.
        var portrait = document.querySelector(".portrait");
        if (!portrait || !("IntersectionObserver" in window)) return;
        new IntersectionObserver(
          function (entries) {
            header.classList.toggle("show-avatar", !entries[0].isIntersecting);
          },
          { rootMargin: "-" + header.offsetHeight + "px 0px 0px 0px" }
        ).observe(portrait);
      })();
    </script>
  </body>
</html>
